# ============================================================
# AURUM · 锦市 — 环境变量模板
# 复制为 .env.local 并填入你自己的真实凭证
#
# 重要：用 Lemon Squeezy 收款时，本站【不需要任何环境变量】也能正常运行，
#       所有收款链接都写在 lib/products.ts 的 payUrl 里。
#       下面这些变量都是「可选 / 进阶」用的。
# ============================================================

# --- 站点 ---
NEXT_PUBLIC_SITE_NAME="AURUM 锦市"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# --- Lemon Squeezy（收款，无需环境变量）---
# 商品付款链接直接写在 lib/products.ts 的每个商品 payUrl 字段中，
# 把 "https://lemonsqueezy.com/l/REPLACE_WITH_YOUR_PAY_LINK" 换成你真实的 Lemon Squeezy 链接即可。
# 收款到账：在 Lemon Squeezy 后台 Settings → Payouts 绑定你的 PayPal。

# --- Google 登录（进阶 / 可选，真实 OAuth 才需要）---
# 参考 README 第 4 节。不填则站内登录为前端模拟（不影响收款）。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- 数据库（进阶 / 可选，做站内「已购解锁」才需要）---
# 可选：Postgres / Supabase / Vercel Postgres 连接串
DATABASE_URL=""
